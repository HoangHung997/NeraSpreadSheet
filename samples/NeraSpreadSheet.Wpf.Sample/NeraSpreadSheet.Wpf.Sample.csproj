<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(NeraRibbonDemo)' == 'true'">
    <RuntimeHostConfigurationOption Include="NeraSpreadSheet.RibbonDemo" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NeraSpreadSheet.Core/NeraSpreadSheet.Core.csproj" />
    <ProjectReference Include="../../src/NeraSpreadSheet.Editing/NeraSpreadSheet.Editing.csproj" />
    <ProjectReference Include="../../src/NeraSpreadSheet.Foundation/NeraSpreadSheet.Foundation.csproj" />
    <ProjectReference Include="../../src/NeraSpreadSheet.OpenXml/NeraSpreadSheet.OpenXml.csproj" />
    <ProjectReference Include="../../src/NeraSpreadSheet.Wpf/NeraSpreadSheet.Wpf.csproj" />
  </ItemGroup>
</Project>
