<Window x:Class="NeraSpreadSheet.Wpf.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nera="clr-namespace:NeraSpreadSheet.Wpf;assembly=NeraSpreadSheet.Wpf"
        Title="NeraSpreadSheet WPF Sample"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="OpenClick" Padding="10,3">Open XLSX</Button>
            <Button Click="SaveClick" Padding="10,3">Save XLSX</Button>
            <Separator />
            <Button Click="BoldClick" Padding="10,3">Bold</Button>
            <Button Click="ItalicClick" Padding="10,3">Italic</Button>
            <Button Click="MergeClick" Padding="10,3">Merge</Button>
            <Button Click="UnmergeClick" Padding="10,3">Unmerge</Button>
            <Button Click="FreezeClick" Padding="10,3">Freeze</Button>
            <Button Click="UnfreezeClick" Padding="10,3">Unfreeze</Button>
            <Separator />
            <Button Click="SplitVerticalClick" Padding="10,3">Split V</Button>
            <Button Click="SplitHorizontalClick" Padding="10,3">Split H</Button>
            <Button Click="SplitBothClick" Padding="10,3">Split 4</Button>
            <Button Click="ClearSplitClick" Padding="10,3">Clear Split</Button>
            <Separator />
            <Button Click="InsertRowsClick" Padding="10,3" ToolTip="Insert the selected whole row range, or one row at the active cell.">Insert Row</Button>
            <Button Click="DeleteRowsClick" Padding="10,3" ToolTip="Delete the selected whole row range, or one row at the active cell.">Delete Row</Button>
            <Button Click="InsertColumnsClick" Padding="10,3" ToolTip="Insert the selected whole column range, or one column at the active cell.">Insert Col</Button>
            <Button Click="DeleteColumnsClick" Padding="10,3" ToolTip="Delete the selected whole column range, or one column at the active cell.">Delete Col</Button>
            <Separator />
            <ToggleButton x:Name="GpuToggle" Click="GpuClick" Padding="10,3"
                          ToolTip="Bật Direct2D trên D3D11 shared texture/D3DImage; tắt để dùng DrawingContext fallback.">
                WPF GPU
            </ToggleButton>
            <TextBlock x:Name="PerfText" Margin="10,0,0,0" VerticalAlignment="Center">Measuring…</TextBlock>
            <Separator />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                Headers: click/select · drag-resize · structural commands follow whole-axis selection
            </TextBlock>
        </ToolBar>
        <Border BorderBrush="#D0D0D0" BorderThickness="1">
            <AdornerDecorator>
                <nera:NeraSpreadsheetControl x:Name="Spreadsheet" />
            </AdornerDecorator>
        </Border>
    </DockPanel>
</Window>
