<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="NeraSpreadSheet.Avalonia.NeraRibbonResources"
                    x:ClassModifier="internal">
  <!-- These resources live on a Nera presenter, never Application.Current. -->
  <FontFamily x:Key="NeraRibbonFontFamily">Segoe UI, Inter, $Default</FontFamily>
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource NeraRibbonFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="3,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource NeraRibbonForeground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="PART_Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <Rectangle Name="PART_FocusRing" Margin="2" RadiusX="2" RadiusY="2" IsHitTestVisible="False"
                     Stroke="{DynamicResource NeraRibbonAccent}" StrokeThickness="1" StrokeDashArray="2,1" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeraRibbonHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonHoverBorder}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource NeraRibbonPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Rectangle#PART_FocusRing"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.45" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource NeraRibbonChecked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
    <Setter Property="FontFamily" Value="{DynamicResource NeraRibbonFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,6,12,5" />
    <Setter Property="Foreground" Value="{DynamicResource NeraRibbonForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chrome" BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
          <Grid>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RecognizesAccessKey="True" />
            <Border Name="PART_Indicator" Height="3" CornerRadius="2" Margin="8,0" VerticalAlignment="Bottom" Background="Transparent" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome"><Setter Property="Background" Value="{DynamicResource NeraRibbonHover}" /></Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource NeraRibbonAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chrome"><Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource NeraRibbonSurface}" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,Auto" KeyboardNavigation.TabNavigation="Local">
          <Border Background="{DynamicResource NeraRibbonTopSurface}" BorderBrush="{DynamicResource NeraRibbonDivider}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter Name="PART_ItemsPresenter" Margin="6,0" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </Border>
          <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource NeraRibbonDivider}" BorderThickness="0,0,0,1">
            <Panel ClipToBounds="True">
              <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
              <ContentPresenter Name="PART_SelectedContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
            </Panel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource NeraRibbonFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="{DynamicResource NeraRibbonFieldSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource NeraRibbonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonFieldBorder}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="4,1" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <Grid ColumnDefinitions="*,18">
            <ContentControl Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            Margin="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox" Text="{TemplateBinding Text, Mode=TwoWay}" IsVisible="{TemplateBinding IsEditable}"
                     Padding="{TemplateBinding Padding}" MinHeight="0" Background="Transparent" BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}" />
            <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press" Padding="0" BorderThickness="0"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}">
              <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource NeraRibbonForeground}" StrokeThickness="1"
                    Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{TemplateBinding}"
                   Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" InheritsTransform="True"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Border Background="{DynamicResource NeraRibbonSurface}" BorderBrush="{DynamicResource NeraRibbonFieldBorder}" BorderThickness="1" Padding="3" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome"><Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Chrome"><Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="5,3" /><Setter Property="Foreground" Value="{DynamicResource NeraRibbonForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chrome" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Chrome"><Setter Property="Background" Value="{DynamicResource NeraRibbonHover}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_Chrome"><Setter Property="Background" Value="{DynamicResource NeraRibbonChecked}" /><Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource NeraRibbonFontFamily}" /><Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" /><Setter Property="Foreground" Value="{DynamicResource NeraRibbonForeground}" />
    <Setter Property="Padding" Value="5,3" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
          <Grid ColumnDefinitions="22,*,18">
            <ContentControl Name="PART_IconPresenter" Content="{TemplateBinding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
            <Path Name="PART_Check" Data="M1,5 L4,8 L10,1" Stroke="{DynamicResource NeraRibbonAccent}" StrokeThickness="2" Width="12" Height="10" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" VerticalAlignment="Center" />
            <Path Name="PART_Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource NeraRibbonForeground}" StrokeThickness="1"
                  Width="4" Height="8" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}" Placement="RightEdgeAlignedTop" IsLightDismissEnabled="False">
              <Border Background="{DynamicResource NeraRibbonSurface}" BorderBrush="{DynamicResource NeraRibbonDivider}" BorderThickness="1" CornerRadius="4" Padding="3">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected /template/ Border#PART_Chrome"><Setter Property="Background" Value="{DynamicResource NeraRibbonHover}" /><Setter Property="BorderBrush" Value="{DynamicResource NeraRibbonAccent}" /></Style>
    <Style Selector="^:empty /template/ Path#PART_Arrow"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:checked /template/ Path#PART_Check"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:checked /template/ ContentControl#PART_IconPresenter"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="NeraRibbonTopLevelMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
          <Panel>
            <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding $parent[Menu]}">
              <Border Background="{DynamicResource NeraRibbonSurface}" BorderBrush="{DynamicResource NeraRibbonDivider}" BorderThickness="1" CornerRadius="4" Padding="3">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="ItemContainerTheme" Value="{StaticResource NeraRibbonTopLevelMenuItem}" />
    <Setter Property="Background" Value="{DynamicResource NeraRibbonTopSurface}" />
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" /></Border></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource NeraRibbonSurface}" BorderBrush="{DynamicResource NeraRibbonDivider}" BorderThickness="1" CornerRadius="4" Padding="3">
          <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Height" Value="1" /><Setter Property="Margin" Value="4,3" />
    <Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource NeraRibbonDivider}" Height="1" /></ControlTemplate></Setter>
  </ControlTheme>
</ResourceDictionary>
