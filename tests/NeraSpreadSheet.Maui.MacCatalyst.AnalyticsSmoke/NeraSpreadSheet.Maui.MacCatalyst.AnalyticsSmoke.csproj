<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <RootNamespace>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</RootNamespace>
    <AssemblyName>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</ApplicationTitle>
    <ApplicationId>com.neraspreadsheet.maccatalystanalyticssmoke</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <IsPackable>false</IsPackable>
    <Description>Loaded MAUI Mac Catalyst VoiceOver analytics accessibility smoke for NeraSpreadSheet. Default MAUI single-project items remain enabled so Platforms/MacCatalyst/Info.plist participates in app-bundle generation exactly as it does in the official MAUI template. Xcode version validation is disabled only for this CI smoke host because the hosted runner can carry a newer Xcode patch than the installed .NET Mac Catalyst pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NeraSpreadSheet.Maui/NeraSpreadSheet.Maui.csproj" />
  </ItemGroup>
</Project>
