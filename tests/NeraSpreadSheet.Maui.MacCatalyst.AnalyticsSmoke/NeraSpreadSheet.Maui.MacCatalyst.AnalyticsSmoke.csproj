<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <RootNamespace>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</RootNamespace>
    <AssemblyName>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <ApplicationTitle>NeraSpreadSheet.Maui.MacCatalyst.AnalyticsSmoke</ApplicationTitle>
    <ApplicationId>com.neraspreadsheet.maccatalystanalyticssmoke</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <IsPackable>false</IsPackable>
    <Description>Loaded MAUI Mac Catalyst VoiceOver analytics accessibility smoke for NeraSpreadSheet. The technical application title is intentionally aligned with the assembly name so CI bundle discovery is stable; the runtime identifier is selected by CI to match the hosted Mac architecture, and Xcode version validation is disabled only for this CI smoke host because the hosted runner can carry a newer Xcode patch than the installed .NET Mac Catalyst pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NeraSpreadSheet.Maui/NeraSpreadSheet.Maui.csproj" />
  </ItemGroup>
</Project>
