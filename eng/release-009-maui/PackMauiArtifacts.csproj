<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <NuspecFile>$(NeraMauiNuspec)</NuspecFile>
    <NuspecBasePath>$(NeraMauiPayload)</NuspecBasePath>
  </PropertyGroup>
  <Target Name="RequireVerifiedInputs" BeforeTargets="Pack">
    <Error Condition="'$(NeraMauiNuspec)' == '' Or '$(NeraMauiPayload)' == ''" Text="Use assemble-release-009-maui-packages.ps1 with verified shard inputs." />
  </Target>
</Project>
